// Образец ~/.vibememory/config.json. Засевается install'ом рядом с рабочим файлом.
//
// ВАЖНО: сам config.json — строгий JSON. Комментарии и висячие запятые в нём запрещены;
// этот файл — образец для чтения, а не для переименования. Полное описание всех ключей:
// docs/manuals/configSpec.md (его можно целиком скормить модели и попросить собрать конфиг).
{
  // Обязателен. Уникальное имя ЭТОЙ машины; попадает в имена всего, что она пишет в стор,
  // поэтому конфликтов между машинами не бывает по построению.
  "machineId": "mac-main",

  // Обязателен. Git-remote стора — приватный репозиторий на своём хосте.
  "remote": "ssh://git@host/vibememory/store.git",

  // Необязателен. Как одна и та же папка называется на разных машинах: рабочий каталог
  // уезжает в стор как {PROJECTS}/VibeCode/VibeIDE и на Windows становится D:/Projects/...
  // Путь — абсолютный путь ЭТОЙ машины. Каталог вне всех корней не переводится и не уезжает.
  "roots": {
    "PROJECTS": "/Volumes/Storage/Projects",
    "HOME_PROJECTS": "/Users/me/Projects"
  },

  // Необязателен, по умолчанию "auto" — искать стор дескрипторов Desktop там, где его кладут
  // установщики. Явный путь нужен, когда поиск ошибается (например, MSIX-раскладка Windows).
  "desktopStore": "auto",

  // Необязателен. Ручной предохранитель имён стора: применяется до git и всех автоматик.
  // Литерал совпадает точно; поддерево — только явным "/**". Разделитель всегда "/".
  "nameOverrides": {
    "/Volumes/Storage/Projects/VibeCode/VibeSweep": "VibeSweep",
    "/Volumes/Storage/Projects/VibeCode/VibeSweep/**": "VibeSweep"
  },

  // Необязателен. Каталоги, для которых движок не делает ничего. "/" — корень файловой
  // системы: сессии раннеров живут там, и стора с именем «root» не бывает. Домашний каталог
  // стоит внести по той же причине: claude, запущенный из ~, завёл бы стор по имени папки.
  "ignoreCwd": ["/", "/Users/me"]
}
