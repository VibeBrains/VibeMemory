        "machine": "laptop",
        "storeName": "alice-laptop",
        "keyId": "mk_3f8k1p0z",
        "sshHost": "vibememory.ru",
        "sshUser": "vmgit",
        "remote": "teams/syncteam.git",
        "hostKeys": [
          "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMzMz"
        ]
      },
      "expect": {
        "key": {
          "team": "syncteam",
          "storeName": "alice-laptop",
          "keyId": "mk_3f8k1p0z"
        }
      }
    },
