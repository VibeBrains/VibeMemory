      "machine": "win",
      "toPortable": "D:\\Projects\\VibeCode\\VibeIDE",
      "thenToLocalOn": "mac",
      "expect": {
        "portable": "{PROJECTS}/VibeCode/VibeIDE",
        "local": "/Volumes/Storage/Projects/VibeCode/VibeIDE"
      }
    }
  ],
