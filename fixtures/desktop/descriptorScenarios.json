{
  "description": "Guard дескрипторов Desktop и перевод cwd между машинами. Реальный стор дескрипторов лежит в облачной папке и читать его нельзя (дегидрированные файлы тянутся из сети), поэтому кейсы computed/unverified: форма полей взята из опубликованных в docs/knowledge/claudeDesktop/sessionStore.md частот по 165 файлам local_*.json, значения синтетические. Корни машин — из примера config.json в architecture §9.",
  "machines": {
    "mac": {
      "syntax": "posix",
      "roots": {
        "PROJECTS": "/Volumes/Storage/Projects",
        "HOME": "/Users/owner",
        "HOME_PROJECTS": "/Users/owner/Projects"
      }
    },
    "win": {
      "syntax": "windows",
      "roots": {
        "PROJECTS": "D:\\Projects",
        "HOME": "C:\\Users\\owner"
      }
    },
    "bare": { "syntax": "posix", "roots": {} }
  },
  "rootCases": [
    {
      "id": "portable-mac-project",
      "provenance": "computed",
      "note": "Обычный путь владельца внутри объявленного корня.",
      "machine": "mac",
      "toPortable": "/Volumes/Storage/Projects/VibeCode/VibeIDE",
      "expect": { "portable": "{PROJECTS}/VibeCode/VibeIDE" }
    },
    {
      "id": "portable-longest-root-wins",
      "provenance": "computed",
      "note": "Вложенные корни: побеждает самый длинный, иначе путь получит менее точный смысл.",
      "machine": "mac",
      "toPortable": "/Users/owner/Projects/VibeCode/VibeIDE",
      "expect": { "portable": "{HOME_PROJECTS}/VibeCode/VibeIDE" }
    },
    {
      "id": "portable-root-itself",
      "provenance": "computed",
      "note": "Путь, равный корню, — голое {NAME} без хвостового слеша.",
      "machine": "mac",
      "toPortable": "/Volumes/Storage/Projects",
      "expect": { "portable": "{PROJECTS}" }
    },
    {
      "id": "portable-outside-roots",
      "provenance": "computed",
      "note": "Смысл механизма: путь вне корней не переводится, и потому не уезжает.",
      "machine": "mac",
      "toPortable": "/private/tmp/scratch/thing",
      "expect": { "error": "outside" }
    },
    {
      "id": "portable-sibling-not-a-prefix",
      "provenance": "computed",
      "note": "Совпадение по строке не годится: /Users/ownerX не внутри /Users/owner.",
      "machine": "mac",
      "toPortable": "/Users/ownerX/Projects",
      "expect": { "error": "outside" }
    },
    {
      "id": "portable-no-roots-declared",
      "provenance": "computed",
      "note": "Машина без корней не переводит ничего.",
      "machine": "bare",
      "toPortable": "/Users/owner/Projects/A",
      "expect": { "error": "outside" }
    },
    {
      "id": "portable-windows-drive",
      "provenance": "unverified",
      "note": "В сторе 23 дескриптора с D:\\… — их пишет Windows, читает Mac.",
      "machine": "win",
      "toPortable": "D:\\Projects\\VibeCode\\VibeIDE",
      "expect": { "portable": "{PROJECTS}/VibeCode/VibeIDE" }
    },
    {
      "id": "portable-windows-case",
      "provenance": "unverified",
      "note": "Windows сравнивает пути без учёта регистра — корень должен совпасть.",
      "machine": "win",
      "toPortable": "d:\\projects\\VibeCode",
      "expect": { "portable": "{PROJECTS}/VibeCode" }
    },
    {
      "id": "local-mac",
      "provenance": "computed",
      "note": "Обратный перевод в POSIX-форму принимающей машины.",
      "machine": "mac",
      "toLocal": "{PROJECTS}/VibeCode/VibeIDE",
      "expect": { "local": "/Volumes/Storage/Projects/VibeCode/VibeIDE" }
    },
    {
      "id": "local-windows",
      "provenance": "unverified",
      "note": "Тот же портативный путь на Windows-машине рендерится с её префиксом диска.",
      "machine": "win",
      "toLocal": "{PROJECTS}/VibeCode/VibeIDE",
      "expect": { "local": "D:/Projects/VibeCode/VibeIDE" }
    },
    {
      "id": "local-root-itself",
      "provenance": "computed",
      "note": "Голое {NAME} возвращает сам корень.",
      "machine": "mac",
