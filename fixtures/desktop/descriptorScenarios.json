      "note": "Битая форма — отказ, а не половина имени корня.",
      "machine": "mac",
      "toLocal": "{PROJECTS/A",
      "expect": { "error": "notPortable" }
    },
    {
      "id": "round-trip-windows-to-mac",
      "provenance": "unverified",
