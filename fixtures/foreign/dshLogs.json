    {
      "id": "framesJoined",
      "note": "A log is many frames; their records join in order, and the header gives the id and the directory",
      "expect": {
        "session": "session-11111111-1111-4111-8111-111111111111",
        "cwd": "/work/Promed",
        "lines": [
          {
            "type": "user",
            "timestamp": "2026-09-21T14:13:21.000Z",
            "message": {
              "role": "user",
              "content": [
                {
                  "type": "text",
                  "text": "list the files"
                }
              ]
            },
            "uuid": "u-1"
          },
          {
            "type": "assistant",
            "timestamp": "2026-09-21T14:13:22.007Z",
            "message": {
              "role": "assistant",
              "content": [
                {
                  "type": "reasoning",
                  "text": "thinking it over"
                },
                {
                  "type": "text",
                  "text": "here they are"
                }
              ]
            },
            "uuid": "a-1"
          },
          {
            "type": "tool/call",
            "timestamp": "2026-09-21T14:13:23.000Z",
            "data": {
              "name": "shell",
              "input": {
                "command": "ls"
              }
            },
            "uuid": "session-11111111-1111-4111-8111-111111111111-3"
          }
        ]
      },
      "log": ""
