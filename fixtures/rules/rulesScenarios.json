        "kept": [
          [
            "attribution",
            "team"
          ],
          [
            "style",
            "project"
          ]
        ],
        "conflicts": []
      }
    },
    {
      "id": "enforced-against-absolute-is-a-conflict-not-a-choice",
      "personal": [
        "---\nid: attribution\ntitle: Атрибуция\nlevel: personal\nabsolute: true\n---\nЗапрещена.\n"
      ],
      "team": [
        "---\nid: attribution\ntitle: Атрибуция\nlevel: team\nenforced: true\n---\nОбязательна.\n"
      ],
      "project": [],
      "expect": {
        "inForce": [
          [
            "attribution",
            "personal",
            []
          ],
          [
            "attribution",
            "team",
            []
          ]
        ],
        "kept": [],
        "conflicts": [
          [
            "attribution",
            "attribution"
          ]
        ]
      }
    },
    {
      "id": "same-text-above-is-no-news",
      "personal": [
        "---\nid: tone\ntitle: Тон\nlevel: personal\nabsolute: true\n---\nПрямо.\n"
      ],
      "team": [
        "---\nid: tone\ntitle: Тон\nlevel: team\n---\nПрямо.\n"
      ],
      "project": [],
      "expect": {
        "inForce": [
          [
            "tone",
            "personal",
            []
          ]
        ],
        "kept": [],
        "conflicts": []
      }
    }
  ],
  "assembly": [
    {
      "id": "round-trip-and-one-edited-rule",
      "base": "# Правила владельца\n\nКоротко.\n",
      "rules": [
        [
          "---\nid: tone\ntitle: Тон\nlevel: personal\n---\nПрямо.\nБез воды.\n",
          []
        ],
        [
          "---\nid: tests\ntitle: Тесты\nlevel: project\n---\nГонять bun test.\n",
          [
            "personal"
          ]
        ]
      ],
      "edits": [
        [
          "Без воды.",
          "Без воды и повторов."
        ],
        [
          "Коротко.",
          "Коротко.\n\nМоя заметка вне правил."
        ]
      ],
      "expect": [
        {
          "piece": "base",
          "edited": true
        },
        {
          "piece": "rule",
          "id": "tone",
          "edited": true,
          "body": "Прямо.\nБез воды и повторов.\n"
        },
        {
          "piece": "rule",
          "id": "tests",
          "edited": false,
          "body": "Гонять bun test.\n"
        }
      ]
    },
    {
      "id": "text-outside-markers-is-kept-apart",
      "base": null,
      "rules": [
        [
          "---\nid: tone\ntitle: Тон\nlevel: personal\n---\nПрямо.\n",
          []
        ]
      ],
      "edits": [
        [
          "<!-- /vibememory:rule -->\n",
          "<!-- /vibememory:rule -->\n\n## Моё\n\nТолько здесь.\n"
        ]
      ],
      "expect": [
        {
          "piece": "rule",
          "id": "tone",
          "edited": false,
          "body": "Прямо.\n"
        },
        {
          "piece": "outside",
          "text": "## Моё\n\nТолько здесь.\n"
        }
      ]
    },
    {
      "id": "a-cut-marker-is-refused",
      "base": null,
      "rules": [
        [
          "---\nid: tone\ntitle: Тон\nlevel: personal\n---\nПрямо.\n",
          []
        ]
      ],
      "edits": [
        [
          "<!-- /vibememory:rule -->\n",
          ""
        ]
      ],
      "error": "not closed"
    }
  ],
