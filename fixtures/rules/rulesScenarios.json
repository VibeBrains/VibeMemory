{
  "about": "Rules and skills: the formats, the levels stacked, an agent's file assembled and read back, a project's rule files judged. Format of this file: docs/manuals/rulesSpec.md, section «Фикстуры».",
  "rules": [
    {
      "id": "plain",
      "file": "---\nid: commit-language\ntitle: Коммиты — по-русски\nlevel: personal\n---\nSubject и body — по-русски.\nПрефикс `тип(scope):` можно машинным.\n",
      "expect": {
        "id": "commit-language",
        "title": "Коммиты — по-русски",
        "level": "personal",
        "absolute": false,
        "enforced": false,
        "paths": [],
        "body": "Subject и body — по-русски.\nПрефикс `тип(scope):` можно машинным.\n"
      }
    },
    {
      "id": "flags-paths-comments-and-unknown-keys",
      "file": "---\nid: no-attribution   # permanent\ntitle: \"Атрибуция: абсолютный запрет\"\nlevel: personal\nabsolute: true\npaths:\n  - \"**/*.rs\"\n  - docs/**\nreviewed-by: owner\n---\n\nНикаких Co-Authored-By.\n\n",
      "expect": {
        "id": "no-attribution",
        "title": "Атрибуция: абсолютный запрет",
        "level": "personal",
        "absolute": true,
        "enforced": false,
        "paths": [
          "**/*.rs",
          "docs/**"
        ],
        "body": "Никаких Co-Authored-By.\n",
        "extra": [
          "reviewed-by"
        ]
      }
    },
    {
      "id": "flow-list-paths",
      "file": "---\nid: team-style\ntitle: Стиль команды\nlevel: team\nenforced: true\npaths: [src/**, tests/**]\n---\nТабы — нет.\n",
      "expect": {
        "id": "team-style",
        "title": "Стиль команды",
        "level": "team",
        "absolute": false,
        "enforced": true,
        "paths": [
          "src/**",
          "tests/**"
        ],
        "body": "Табы — нет.\n"
      }
    },
    {
      "id": "no-frontmatter",
      "file": "# Просто текст\n",
      "error": "no frontmatter"
    },
    {
      "id": "bad-id",
      "file": "---\nid: Commit_Language\ntitle: X\nlevel: personal\n---\ntext\n",
      "error": "is not kebab-case"
    },
    {
      "id": "bad-level",
      "file": "---\nid: a\ntitle: X\nlevel: global\n---\ntext\n",
      "error": "is not personal, team or project"
    },
    {
      "id": "absolute-only-personal",
      "file": "---\nid: a\ntitle: X\nlevel: team\nabsolute: true\n---\ntext\n",
      "error": "absolute is a personal rule's flag"
    },
    {
      "id": "enforced-only-team",
      "file": "---\nid: a\ntitle: X\nlevel: project\nenforced: true\n---\ntext\n",
      "error": "enforced is a team rule's flag"
    },
    {
      "id": "empty-text",
      "file": "---\nid: a\ntitle: X\nlevel: project\n---\n\n\n",
      "error": "has no text"
    },
    {
      "id": "flag-not-boolean",
      "file": "---\nid: a\ntitle: X\nlevel: personal\nabsolute: yes\n---\ntext\n",
      "error": "absolute is true or false"
    },
    {
      "id": "token-in-text",
      "file": "---\nid: a\ntitle: X\nlevel: personal\n---\nТокен: vmt_7q2m9x4a_1111111111111111111111111111111111111111\n",
      "error": "holds a vibememory token"
    },
    {
      "id": "unclosed-frontmatter",
      "file": "---\nid: a\ntitle: X\n",
      "error": "no frontmatter"
    }
  ],
  "skills": [
    {
      "id": "folded-description-and-claude-keys",
      "directory": "save-session",
      "file": "---\nname: save-session\ndescription: >\n  Сохранить состояние сессии\n  как хендофф.\nallowed-tools: Read, Write\n---\n# save-session\n",
      "expect": {
        "name": "save-session",
        "description": "Сохранить состояние сессии как хендофф.",
        "claudeOnly": [
          "allowed-tools"
        ]
      }
    },
    {
      "id": "literal-description",
      "directory": "watch",
      "file": "---\nname: watch\ndescription: |\n  Смотрит видео.\n  Слушает аудио.\n---\nbody\n",
      "expect": {
        "name": "watch",
        "description": "Смотрит видео.\nСлушает аудио.",
        "claudeOnly": []
      }
    },
    {
      "id": "name-not-kebab",
      "directory": "Save_Session",
      "file": "---\nname: Save_Session\ndescription: x\n---\n",
      "error": "is not kebab-case"
    },
    {
      "id": "name-differs-from-directory",
      "directory": "watch",
      "file": "---\nname: watcher\ndescription: x\n---\n",
      "error": "differs from its directory"
    },
    {
      "id": "no-description",
      "directory": "x",
      "file": "---\nname: x\n---\nbody\n",
      "error": "description is missing"
    },
    {
      "id": "invocation-not-boolean",
      "directory": "x",
      "file": "---\nname: x\ndescription: d\nuser-invocable: maybe\n---\n",
      "error": "user-invocable is true or false"
    }
  ],
  "layers": [
    {
