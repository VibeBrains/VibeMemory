      "personal": [
        "---\nid: tests\ntitle: Тесты\nlevel: personal\n---\nГонять cargo test.\n",
        "---\nid: tone\ntitle: Тон\nlevel: personal\n---\nПрямо.\n"
      ],
      "team": [
        "---\nid: tests\ntitle: Тесты команды\nlevel: team\n---\nГонять make test.\n"
      ],
      "project": [
        "---\nid: tests\ntitle: Тесты проекта\nlevel: project\n---\nГонять bun test.\n"
