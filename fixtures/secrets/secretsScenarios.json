{
  "description": "Which kind of key a text holds, if any. A key is never written here: `key` gives its head (pieces joined by the test), a filler repeated to a length, and `{key}` in `text` stands where the built value goes. Format - docs/manuals/secretsFixtures.md",
  "cases": [
    {
      "id": "openAiLegacy",
      "provenance": "computed",
      "note": "The old `sk-` key: forty-eight characters of a random-looking run, with digits.",
      "text": "OPENAI_API_KEY={key}",
      "key": {
        "head": [
          "sk-"
        ],
        "fill": "a1",
        "length": 48
      },
      "expect": {
        "kind": "openAiKey"
      }
    },
    {
      "id": "openAiProject",
      "provenance": "computed",
      "note": "`sk-proj-` keys carry hyphens and underscores in the run.",
      "text": "key {key} for the demo",
      "key": {
        "head": [
          "sk-",
          "proj-"
        ],
        "fill": "a_1-",
        "length": 60
      },
      "expect": {
        "kind": "openAiKey"
      }
    },
    {
      "id": "anthropic",
      "provenance": "computed",
      "note": "The Anthropic prefix is told apart from the generic OpenAI one.",
      "text": "ANTHROPIC_API_KEY={key}",
      "key": {
        "head": [
          "sk-",
          "ant-",
          "api03-"
        ],
        "fill": "Ab1",
        "length": 80
      },
      "expect": {
        "kind": "anthropicKey"
      }
    },
    {
      "id": "awsAccessKey",
      "provenance": "computed",
      "note": "`AKIA` and sixteen uppercase letters or digits, ending at the word.",
      "text": "aws_access_key_id = {key}\n",
      "key": {
        "head": [
          "AK",
          "IA"
        ],
        "fill": "Q7",
        "length": 16
      },
      "expect": {
        "kind": "awsAccessKey"
      }
    },
    {
      "id": "awsSessionKey",
      "provenance": "computed",
      "note": "`ASIA` is the temporary form of the same key.",
