      "id": "privateKeyRsa",
      "provenance": "computed",
      "note": "The header of a PEM private key is enough: the body need not be there.",
      "text": "{key}\nMIIEvQIBADANBgkqhkiG9w0B\n",
      "key": {
        "head": [
          "-----BE",
          "GIN RSA PRIVATE KEY-----"
        ],
        "fill": "",
        "length": 0
      },
      "expect": {
        "kind": "privateKey"
      }
    },
