# The host's sites, one file: rendered by infra/caddyApply.sh, which hostMcp.sh and
# hostCabinet.sh both call — two scripts writing one Caddyfile would undo each other.
#
# {{DOMAIN}} is the landing for people and the memory server at /mcp for agents. The landing is a static
# build from the VibeMemory.ru repository, put by its deploy.sh under {{SITE}}/current.
# {{APP_DOMAIN}} is for people: the cabinet, and the releases under /dl/ beside its download page.
# {{DEMO_DOMAIN}} is static pages shown to people outside the product — a pitch, a demo — put by
# infra/demoDeploy.sh under {{DEMO}}/current.
# {{IDE_DOMAIN}} is the VibeIDE landing: a static build from the VibeIDE.ru repository, put by its deploy.sh
# under {{IDE_SITE}}/current. The family's sites live on one host, so this file is theirs too.
{{DOMAIN}} {
	handle /mcp {
		reverse_proxy 127.0.0.1:{{MCP_PORT}}
	}
	handle {
		root * {{SITE}}/current
		file_server
	}
}

{{APP_DOMAIN}} {
	# The one-line installers, from the releases directory beside the archives they fetch.
	handle /install.sh {
		root * {{RELEASES}}
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	handle /install.ps1 {
		root * {{RELEASES}}
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}
	# The archives and their sums; no directory listing.
	handle_path /dl/* {
		root * {{RELEASES}}
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:{{CABINET_PORT}}
	}
}

{{DEMO_DOMAIN}} {
	root * {{DEMO}}/current
	file_server
}

{{IDE_DOMAIN}} {
	root * {{IDE_SITE}}/current
	encode gzip
	# Pages carry the download links of the latest builds: a cached page would send people to an old build.
	# Bundled assets are named by their content, so they never change under the same name.
	@pages not path /_astro/*
	header @pages Cache-Control "no-cache"
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	file_server
}

www.{{IDE_DOMAIN}} {
	redir https://{{IDE_DOMAIN}}{uri} permanent
}
